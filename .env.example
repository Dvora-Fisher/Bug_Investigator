# Copy this file to .env and fill in your own values. .env is never committed.

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# low | medium | high  (lower = fewer thinking tokens = cheaper)
LLM_EFFORT=low

# --- Cost control ---
# Hard stop for the whole app per calendar month (also set a limit in the Anthropic Console).
MONTHLY_BUDGET_USD=15
# Hard stop for a single investigation (input + output tokens).
INVESTIGATION_TOKEN_BUDGET=300000

# --- Investigation behaviour ---
# improved = evidence ledger + challenge step; baseline = simple flow (used for the LangSmith comparison)
INVESTIGATION_MODE=improved

# --- Execution sandbox (Docker) ---
# false = never execute project code (analysis and editing only)
EXECUTION_ENABLED=true
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_RUN_TIMEOUT_S=180
# Reuse downloaded packages between investigations (much faster for C#). false = full isolation.
SHARED_PACKAGE_CACHE=true

# --- Network ---
# Use the Windows certificate store for HTTPS (needed behind filters such as NetFree).
USE_SYSTEM_TRUST_STORE=true

# --- LangSmith (stage E) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bug-investigator
